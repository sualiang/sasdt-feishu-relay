# ============================================================
# SASDT 飞书中转服务 — 环境变量模板
# 复制为 .env 并填入实际值
# ============================================================

# 服务配置
PORT=3000
NODE_ENV=production

# ============================================================
# 飞书应用凭证（小龙填实际值）
# ============================================================
FEISHU_APP_ID=cli_xxxxx
FEISHU_APP_SECRET=xxxxx
FEISHU_VERIFICATION_TOKEN=xxxxx

# ============================================================
# AI API 密钥（按需配置，不用的留空）
# ============================================================
DEEPSEEK_API_KEY=
DOUBAO_API_KEY=
CLAUDE_API_KEY=
QIANWEN_API_KEY=

# ============================================================
# 角色 System Prompt（可自定义每个角色的 AI 人格）
# ============================================================
PROMPT_DOUBAO=你是豆包，SASDT 体系的项目总监。负责接收需求、验收测试、全线联调。请用中文专业地回答。
PROMPT_KE=你是小克，SASDT 体系的技术总监。负责架构设计、代码审计。
PROMPT_KAI=你是小开，SASDT 体系的开发工程师。负责编码实现。请用中文回答。
PROMPT_LONG=你是小龙，SASDT 体系的运维。负责环境搭建、部署上线、服务器运维。请用中文回答。
PROMPT_QIAN=你是小千，SASDT 体系的项目审计。负责代码审计、规则检查。请用中文回答。

# ============================================================
# 日志级别: error / warn / info / debug
# ============================================================
LOG_LEVEL=info
